<%= link_to("Back to List", books_path, class: 'back-link') %>

<div class="books show">
  <h2>Show Book</h2>

  <div class="actions">
    <%= link_to('Edit', edit_book_path(@book)) %>
    <%= link_to('Delete', delete_book_path(@book)) %>
  </div>

  <table summary="Book detail view">
    <tr>
      <th>Title</th>
      <td><%= @book.title %></td>
    </tr>
    <tr>
      <th>Author</th>
      <td><%= @book.author %></td>
    </tr>
    <tr>
      <th>Price</th>
      <td><%= number_to_currency(@book.price) %></td>
    </tr>
    <tr>
      <th>Publication Date</th>
      <td><%= @book.date.strftime('%B %d, %Y') if @book.date %></td>
    </tr>
  </table>
</div>

<h1>New UserBook</h1>

<%= form_with(model: @user_book, local: true) do |f| %>
  <div>
    <%= f.label :user_id %>
    <%= f.collection_select :user_id, User.all, :id, :username, prompt: "Select a user" %>
  </div>

  <div>
    <%= f.label :book_id %>
    <%= f.collection_select :book_id, Book.all, :id, :title, prompt: "Select a book" %>
  </div>

  <div>
    <%= f.submit "Create UserBook" %>
  </div>
<% end %>

<%= link_to "Back to User Books", user_books_path %>
<%= link_to "View All Users", users_path %>
<%= link_to "View All Books", books_path %>
